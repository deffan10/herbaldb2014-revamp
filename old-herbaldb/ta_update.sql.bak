--
-- Table structure for table `speciescontent`
--

CREATE TABLE IF NOT EXISTS `speciescontent` (
  `specon_id` mediumint(10) NOT NULL auto_increment,
  `spe_id` int(6) default NULL,
  `con_id` mediumint(6) default NULL,
  `ref_id` mediumint(2) default NULL,
  `specon_insert_by` mediumint(3) NOT NULL,
  `specon_insert_date` varchar(20) NOT NULL,
  `specon_update_by` mediumint(3) NOT NULL,
  `specon_update_date` varchar(20) NOT NULL,
  `specon_verified_by` mediumint(3) default NULL,
  `specon_verified_date` varchar(20) default NULL,
  PRIMARY KEY  (`specon_id`),
  UNIQUE KEY `spe_species_id` (`spe_id`,`con_id`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=9846 ;

