--
-- Table structure for table `species_photos`
--

CREATE TABLE IF NOT EXISTS `species_photos` (
  `sph_id` int(8) NOT NULL auto_increment,
  `spe_id` int(6) NOT NULL,
  `sph_filename` varchar(100) NOT NULL,
  `sph_note` text,
  `sph_insert_by` mediumint(3) default NULL,
  `sph_insert_date` varchar(20) default NULL,
  `sph_verified_by` mediumint(3) default NULL,
  `sph_verified_date` varchar(20) default NULL,
  PRIMARY KEY  (`sph_id`),
  UNIQUE KEY `spe_id` (`spe_id`,`sph_filename`)
) ENGINE=MyISAM DEFAULT CHARSET=latin1 AUTO_INCREMENT=1 ;

