--
-- Table structure for table `virtue`
--

CREATE TABLE IF NOT EXISTS `virtue` (
  `vir_id` int(8) NOT NULL auto_increment,
  `spe_id` int(6) NOT NULL,
  `hp_code` mediumint(3) NOT NULL,
  `vir_type` varchar(12) default NULL,
  `vir_value` text,
  `vir_value_en` text,
  `vir_value_latin` text,
  `ref_id` mediumint(2) default NULL,
  `vir_insert_by` mediumint(3) default NULL,
  `vir_insert_date` varchar(20) default NULL,
  `vir_update_by` mediumint(3) default NULL,
  `vir_update_date` varchar(20) default NULL,
  `vir_verified_by` mediumint(3) default NULL,
  `vir_verified_date` varchar(20) default NULL,
  PRIMARY KEY  (`vir_id`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=6973 ;

