--
-- Table structure for table `users`
--

CREATE TABLE IF NOT EXISTS `users` (
  `use_id` mediumint(3) NOT NULL auto_increment,
  `use_fullname` varchar(100) NOT NULL,
  `use_email` varchar(100) NOT NULL,
  `use_gender` tinyint(1) NOT NULL,
  `use_birthdate` varchar(10) NOT NULL,
  `use_occupation` int(2) default NULL,
  `use_country` int(3) default NULL,
  `use_city` int(3) default NULL,
  `use_address` text,
  `use_foto` varchar(100) default NULL,
  `use_cv` varchar(100) default NULL,
  `rol_id` mediumint(2) NOT NULL,
  `use_username` varchar(20) NOT NULL,
  `use_password` varchar(32) NOT NULL,
  `use_pass_ori` varchar(32) NOT NULL,
  `use_is_active` tinyint(1) NOT NULL,
  `use_update_date` varchar(20) NOT NULL,
  `use_update_by` mediumint(3) NOT NULL,
  `use_reg_date` varchar(20) NOT NULL,
  `use_last_login_ip` varchar(15) NOT NULL,
  `use_last_login_date` varchar(20) NOT NULL,
  PRIMARY KEY  (`use_id`),
  UNIQUE KEY `use_email` (`use_email`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=22 ;

