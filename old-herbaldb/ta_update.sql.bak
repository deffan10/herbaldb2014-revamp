--
-- Table structure for table `comments_contents`
--

CREATE TABLE IF NOT EXISTS `comments_contents` (
  `comcon_id` int(8) NOT NULL auto_increment,
  `use_id` mediumint(3) NOT NULL,
  `con_id` int(6) NOT NULL,
  `comcon_content` text NOT NULL,
  `comcon_insert_date` varchar(20) NOT NULL,
  PRIMARY KEY  (`comcon_id`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=35 ;

