-- --------------------------------------------------------

--
-- Table structure for table `contents`
--

CREATE TABLE IF NOT EXISTS `contents` (
  `con_id` int(6) NOT NULL auto_increment,
  `con_contentname` varchar(200) default NULL,
  `con_knapsack_id` varchar(20) default NULL,
  `con_metabolite_id` varchar(100) default NULL,
  `con_pubchem_id` varchar(20) default NULL,
  `contgroup_id` mediumint(2) default NULL,
  `con_source` varchar(100) default NULL,
  `con_speciesname` varchar(100) default NULL,
  `con_file_mol1` varchar(100) default NULL,
  `con_file_mol2` varchar(100) default NULL,
  `con_insert_by` mediumint(3) NOT NULL,
  `con_insert_date` varchar(20) NOT NULL,
  `con_update_by` mediumint(3) NOT NULL,
  `con_update_date` varchar(20) NOT NULL,
  `con_verified_by` mediumint(3) default NULL,
  `con_verified_date` varchar(20) default NULL,
  PRIMARY KEY  (`con_id`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=6777 ;

