--
-- Table structure for table `aliases`
--

CREATE TABLE IF NOT EXISTS `aliases` (
  `ali_id` int(8) NOT NULL auto_increment,
  `spe_id` int(6) default NULL,
  `ali_speciesname` varchar(100) default NULL,
  `ali_foundername` varchar(100) default NULL,
  `ali_varietyname` varchar(100) default NULL,
  `ref_id` mediumint(2) default NULL,
  `ali_insert_by` mediumint(3) NOT NULL,
  `ali_insert_date` varchar(20) NOT NULL,
  `ali_update_by` mediumint(3) NOT NULL,
  `ali_update_date` varchar(20) NOT NULL,
  `ali_verified_by` mediumint(3) default NULL,
  `ali_verified_date` varchar(20) default NULL,
  PRIMARY KEY  (`ali_id`),
  UNIQUE KEY `SPE_species_id` (`spe_id`,`ali_speciesname`,`ali_foundername`)
) ENGINE=MyISAM  DEFAULT CHARSET=latin1 AUTO_INCREMENT=4165 ;

